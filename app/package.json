{
  "name": "homacapture",
  "productName": "HomaCapture",
  "version": "0.2.0",
  "description": "Record your screen once, let the software make it look good. Open-source Screen Studio / Loom alternative.",
  "main": "out/main/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "bundle:video": "remotion bundle src/video/index.ts --out-dir out/remotion --log error",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "dist": "npm run build && npm run bundle:video && npm run bundle:runtime && electron-builder --win nsis --publish never",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build && npm run bundle:video && npm run build:sysaudio && electron-builder --mac dmg --arm64 --publish never",
    "build:sysaudio": "clang -fobjc-arc -O2 -Wall -mmacosx-version-min=13.0 -framework Foundation -framework ScreenCaptureKit -framework CoreMedia -framework AudioToolbox ../recorder/mac/sysaudio.m -o ../recorder/mac/homacapture-sysaudio"
  },
  "keywords": [],
  "author": "Homalabs",
  "license": "MIT",
  "type": "module",
  "build": {
    "appId": "com.homalabs.narrate",
    "productName": "HomaCapture",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../recorder",
        "to": "recorder",
        "filter": [
          "**/*.py",
          "mac/homacapture-sysaudio"
        ]
      },
      {
        "from": "out/remotion",
        "to": "remotion"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "asarUnpack": [
      "node_modules/@remotion/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "HomaCapture-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "HomaCapture records your voice with your screen.",
        "NSCameraUsageDescription": "HomaCapture can record your camera beside your screen.",
        "NSAppleEventsUsageDescription": "HomaCapture uses this to show your recordings in Finder."
      }
    },
    "dmg": {
      "artifactName": "HomaCapture-${version}-mac-${arch}.${ext}",
      "title": "HomaCapture"
    }
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.533",
    "@remotion/cli": "^4.0.533",
    "@remotion/player": "^4.0.533",
    "@remotion/renderer": "^4.0.533",
    "@tabler/icons-react": "^3.31.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.533"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron-builder@26.15.3": true,
    "electron-winstaller@5.4.0": true
  }
}
